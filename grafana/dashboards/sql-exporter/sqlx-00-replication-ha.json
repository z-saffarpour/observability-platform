    {
      "datasource": { "type": "prometheus", "uid": "ce0xqwhy35wqod" },
      "description": "Availability groups with synchronization_health < HEALTHY, counted from PRIMARY replicas only.",
      "fieldConfig": {
        "defaults": {
          "displayName": "Unhealthy AGs",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 3, "w": 3, "x": 0, "y": 1 },
      "hideTimeOverride": true,
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "ce0xqwhy35wqod" },
          "editorMode": "code",
          "expr": "count(((mssql_alwayson_group_synchronization_health{job=\"sql_exporter\", instance=~\"$instance\"} < 2) and on(instance, availability_group_name) (mssql_alwayson_replica_role{job=\"sql_exporter\", instance=~\"$instance\", role_desc=\"PRIMARY\"} == 1))) or vector(0)",
          "instant": true,
          "legendFormat": "Unhealthy AGs",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Unhealthy AGs",
      "type": "stat"
    },
