apiVersion: 1

providers:
  - name: SQL Exporter
    orgId: 1
    folder: SQL Exporter
    type: file
    disableDeletion: true
    allowUiUpdates: false
    updateIntervalSeconds: 30
    options:
      path: __DASHBOARDS_ROOT__/sql-exporter

  - name: Windows Exporter
    orgId: 1
    folder: Windows Exporter
    type: file
    disableDeletion: true
    allowUiUpdates: false
    updateIntervalSeconds: 30
    options:
      path: __DASHBOARDS_ROOT__/windows-exporter

  - name: Alerting
    orgId: 1
    folder: Alerting
    type: file
    disableDeletion: true
    allowUiUpdates: false
    updateIntervalSeconds: 30
    options:
      path: __DASHBOARDS_ROOT__/alertmanager

