[paths]
data = __DATA_ROOT__
logs = __LOG_ROOT__
plugins = __PLUGINS_ROOT__
provisioning = __CONFIG_ROOT__/provisioning

[server]
protocol = http
http_addr = __HTTP_ADDR__
http_port = __HTTP_PORT__
domain = __DOMAIN__
root_url = __ROOT_URL__
enforce_domain = false

[security]
admin_user = __ADMIN_USER__
admin_password = $__file{ __CONFIG_ROOT__/secrets/admin-password }
disable_gravatar = true
cookie_secure = __COOKIE_SECURE__
cookie_samesite = strict

[users]
allow_sign_up = false

[auth.anonymous]
enabled = false

[analytics]
reporting_enabled = false
check_for_updates = false

[log]
mode = console
level = info

