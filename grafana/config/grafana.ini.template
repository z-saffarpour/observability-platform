[paths]
data = {{DATA_ROOT}}
logs = {{LOG_ROOT}}
plugins = {{PLUGINS_ROOT}}
provisioning = {{PROVISIONING_ROOT}}

[server]
protocol = http
http_addr = {{HTTP_ADDR}}
http_port = {{HTTP_PORT}}
domain = {{DOMAIN}}
root_url = {{ROOT_URL}}
enforce_domain = false

[security]
admin_user = {{ADMIN_USER}}
admin_password = $__file{ {{ADMIN_PASSWORD_FILE}} }
disable_gravatar = true
cookie_secure = {{COOKIE_SECURE}}
cookie_samesite = strict

[users]
allow_sign_up = false

[auth.anonymous]
enabled = false

[analytics]
reporting_enabled = false
check_for_updates = true

[log]
mode = console
level = info

