{{ define "email.sql_exporter.subject" -}}
[{{ .CommonLabels.priority }}] {{ .CommonLabels.alertname }} — {{ .CommonLabels.instance }}
{{- end }}

{{ define "email.sql_exporter.html" }}
<!DOCTYPE html>
<html lang="en">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ .CommonLabels.alertname }}</title>
</head>
<body style="margin:0;padding:0;background:#ffffff;color:#000000;">
  <div style="display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;">
    {{- if gt (len .Alerts.Firing) 0 }} {{ len .Alerts.Firing }} firing instances.{{ end }}
    {{- if gt (len .Alerts.Resolved) 0 }} {{ len .Alerts.Resolved }} resolved instances.{{ end }}
    {{- with .CommonAnnotations.summary }} {{ . }}{{ end -}}
  </div>
  <table role="presentation" align="center" width="600" cellpadding="0" cellspacing="0" style="width:600px;max-width:600px;border-collapse:collapse;margin:0 auto;font-family:Inter,Helvetica,Arial,sans-serif;">
    <tr>
      <td style="padding:8px 0 0 0;">
        <h2 style="margin:0;font-size:22px;line-height:1.3;font-weight:700;font-family:Inter,Helvetica,Arial,sans-serif;">&#128193; {{ with .CommonLabels.job }}{{ . }} &rsaquo; {{ end }}{{ .CommonLabels.alertname }}</h2>
      </td>
    </tr>
    {{ if gt (len .Alerts.Firing) 0 }}
    <tr>
      <td style="padding:14px 0 8px 0;">
        <h3 style="margin:0;font-size:18px;line-height:1.3;font-weight:700;font-family:Inter,Helvetica,Arial,sans-serif;color:#931625;">&#128293; {{ len .Alerts.Firing }} firing — action required</h3>
      </td>
    </tr>
    {{ range .Alerts.Firing }}
    <tr>
      <td style="padding:0 0 12px 0;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;border-collapse:collapse;border:2px solid #931625;background:#fff1f2;">
          <tr>
            <td style="background:#931625;color:#ffffff;padding:12px 16px;font-family:Segoe UI,Tahoma,Arial,sans-serif;font-size:16px;line-height:1.4;font-weight:700;">
              FIRING
              <div dir="rtl" style="margin-top:2px;font-size:14px;font-weight:700;font-family:Segoe UI,Tahoma,Arial,sans-serif;">مشکل فعال است</div>
            </td>
          </tr>
          {{ template "email.sql_exporter.card" . }}
          {{ if $.ExternalURL }}
          {{ $filter := "{" }}
          {{ range $i, $p := .Labels.SortedPairs }}
          {{ if gt $i 0 }}{{ $filter = printf "%s," $filter }}{{ end }}
          {{ $filter = printf "%s%s=\"%s\"" $filter $p.Name $p.Value }}
          {{ end }}
          {{ $filter = printf "%s}" $filter }}
          <tr>
            <td style="border-top:1px solid #ed8894;padding:15px 25px;">
              <table role="presentation" cellpadding="0" cellspacing="0" style="border-collapse:separate;">
                <tr>
                  <td align="center" bgcolor="#3D71D9" style="background:#3D71D9;border-radius:3px;">
                    <a href="{{ reReplaceAll "/+$" "" $.ExternalURL }}/#/silences/new?filter={{ $filter | urlquery }}" style="display:inline-block;padding:5px 12px;background:#3D71D9;color:#ffffff;font-family:Inter,Helvetica,Arial,sans-serif;font-size:13px;line-height:1.2;text-decoration:none;border-radius:3px;">Silence</a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          {{ end }}
          <tr>
            <td style="border-top:1px solid #ed8894;padding:10px 25px;font-family:Inter,Helvetica,Arial,sans-serif;font-size:13px;line-height:1.5;color:#931625;">
              Starts at <strong>{{ .StartsAt }}</strong>
              {{- if not .EndsAt.IsZero }}<br>Ends at <strong>{{ .EndsAt }}</strong>{{ end }}
            </td>
          </tr>
        </table>
      </td>
    </tr>
    {{ end }}
    {{ end }}
    {{ if gt (len .Alerts.Resolved) 0 }}
    <tr>
      <td style="padding:14px 0 8px 0;">
        <h3 style="margin:0;font-size:18px;line-height:1.3;font-weight:700;font-family:Inter,Helvetica,Arial,sans-serif;color:#1a7f37;">&#9989; {{ len .Alerts.Resolved }} resolved — problem cleared</h3>
      </td>
    </tr>
    {{ range .Alerts.Resolved }}
    <tr>
      <td style="padding:0 0 12px 0;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;border-collapse:collapse;border:2px solid #1a7f37;background:#f3faf3;">
          <tr>
            <td style="background:#1a7f37;color:#ffffff;padding:12px 16px;font-family:Segoe UI,Tahoma,Arial,sans-serif;font-size:16px;line-height:1.4;font-weight:700;">
              RESOLVED
              <div dir="rtl" style="margin-top:2px;font-size:14px;font-weight:700;font-family:Segoe UI,Tahoma,Arial,sans-serif;">مشکل برطرف شد</div>
            </td>
          </tr>
          {{ template "email.sql_exporter.card" . }}
          {{ if $.ExternalURL }}
          {{ $filter := "{" }}
          {{ range $i, $p := .Labels.SortedPairs }}
          {{ if gt $i 0 }}{{ $filter = printf "%s," $filter }}{{ end }}
          {{ $filter = printf "%s%s=\"%s\"" $filter $p.Name $p.Value }}
          {{ end }}
          {{ $filter = printf "%s}" $filter }}
          <tr>
            <td style="border-top:1px solid #94cb8c;padding:15px 25px;">
              <table role="presentation" cellpadding="0" cellspacing="0" style="border-collapse:separate;">
                <tr>
                  <td align="center" bgcolor="#3D71D9" style="background:#3D71D9;border-radius:3px;">
                    <a href="{{ reReplaceAll "/+$" "" $.ExternalURL }}/#/silences/new?filter={{ $filter | urlquery }}" style="display:inline-block;padding:5px 12px;background:#3D71D9;color:#ffffff;font-family:Inter,Helvetica,Arial,sans-serif;font-size:13px;line-height:1.2;text-decoration:none;border-radius:3px;">Silence</a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          {{ end }}
          <tr>
            <td style="border-top:1px solid #94cb8c;padding:10px 25px;font-family:Inter,Helvetica,Arial,sans-serif;font-size:13px;line-height:1.5;color:#1a7f37;">
              Started <strong>{{ .StartsAt }}</strong>
              {{- if not .EndsAt.IsZero }}<br>Cleared <strong>{{ .EndsAt }}</strong>{{ end }}
            </td>
          </tr>
        </table>
      </td>
    </tr>
    {{ end }}
    {{ end }}
  </table>
</body>
</html>
{{ end }}

{{ define "email.sql_exporter.card" }}
          <tr>
            <td style="border-bottom:1px solid #e4e5e6;padding:10px 8px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
                <tr>
                  <td width="33%" align="center" valign="middle">
                    {{ if eq .Status "firing" }}
                    <span style="display:inline-block;padding:5px 12px;background:#fae0e3;color:#931625;border:1px solid #ed8894;border-radius:3px;font-family:Inter,Helvetica,Arial,sans-serif;font-size:13px;line-height:1.2;">Firing</span>
                    {{ else }}
                    <span style="display:inline-block;padding:5px 12px;background:#e5f2e4;color:#32602b;border:1px solid #94cb8c;border-radius:3px;font-family:Inter,Helvetica,Arial,sans-serif;font-size:13px;line-height:1.2;">Resolved</span>
                    {{ end }}
                  </td>
                  <td width="34%" align="center" valign="middle" style="font-family:Inter,Helvetica,Arial,sans-serif;font-size:13px;line-height:1.4;color:#000000;">
                    <strong>{{ .Labels.alertname }}</strong>
                  </td>
                  <td width="33%" align="center" valign="middle">
                    {{ if .GeneratorURL }}
                    <table role="presentation" cellpadding="0" cellspacing="0" style="border-collapse:separate;">
                      <tr>
                        <td align="center" bgcolor="#3D71D9" style="background:#3D71D9;border-radius:3px;">
                          <a href="{{ reReplaceAll "&" "&amp;" .GeneratorURL }}" style="display:inline-block;padding:5px 12px;background:#3D71D9;color:#ffffff;font-family:Inter,Helvetica,Arial,sans-serif;font-size:13px;line-height:1.2;text-decoration:none;border-radius:3px;">View alert</a>
                        </td>
                      </tr>
                    </table>
                    {{ end }}
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          {{ with .Annotations.summary }}
          <tr>
            <td style="padding:14px 25px 0 25px;font-family:Inter,Helvetica,Arial,sans-serif;font-size:13px;line-height:1.5;color:#000000;"><strong>Summary</strong></td>
          </tr>
          <tr>
            <td style="padding:6px 25px 0 25px;font-family:Inter,Helvetica,Arial,sans-serif;font-size:13px;line-height:1.5;color:#000000;white-space:pre-line;word-break:break-word;">{{ . }}</td>
          </tr>
          {{ end }}
          {{ with .Annotations.summary_fa }}
          <tr>
            <td style="padding:14px 25px 0 25px;font-family:Segoe UI,Tahoma,Arial,sans-serif;font-size:13px;line-height:1.5;color:#000000;"><strong>Summary (FA)</strong></td>
          </tr>
          <tr>
            <td align="right" dir="rtl" style="padding:6px 25px 0 25px;">
              <p dir="RTL" align="right" lang="fa" style="margin:0;font-family:Segoe UI,Tahoma,Arial,sans-serif;font-size:13px;line-height:1.5;color:#000000;direction:rtl;text-align:right;">&#x200F;{{ reReplaceAll "([0-9A-Za-z%][0-9A-Za-z%.:_\\\\-]*)" "\u200e$1\u200e" . }}</p>
            </td>
          </tr>
          {{ end }}
          {{ with .Annotations.description }}
          <tr>
            <td style="padding:14px 25px 0 25px;font-family:Inter,Helvetica,Arial,sans-serif;font-size:13px;line-height:1.5;color:#000000;"><strong>Description</strong></td>
          </tr>
          <tr>
            <td style="padding:6px 25px 0 25px;font-family:Inter,Helvetica,Arial,sans-serif;font-size:13px;line-height:1.5;color:#000000;white-space:pre-line;word-break:break-word;">{{ . }}</td>
          </tr>
          {{ end }}
          {{ with .Annotations.runbook }}
          <tr>
            <td style="padding:14px 25px 0 25px;font-family:Inter,Helvetica,Arial,sans-serif;font-size:13px;line-height:1.5;color:#000000;"><strong>Runbook</strong></td>
          </tr>
          <tr>
            <td style="padding:6px 25px 0 25px;font-family:Inter,Helvetica,Arial,sans-serif;font-size:13px;line-height:1.5;color:#000000;white-space:pre-line;word-break:break-word;">{{ . }}</td>
          </tr>
          {{ end }}
          {{ if .Labels.SortedPairs }}
          <tr>
            <td style="padding:16px 25px 0 25px;font-family:Inter,Helvetica,Arial,sans-serif;font-size:13px;line-height:1.5;color:#000000;"><strong>Labels</strong></td>
          </tr>
          <tr>
            <td style="padding:4px 25px 12px 25px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;font-family:Inter,Helvetica,Arial,sans-serif;font-size:13px;line-height:22px;color:#000000;">
                {{ range .Labels.SortedPairs }}
                <tr>
                  <td valign="top" style="padding:1px 16px 1px 0;font-weight:700;white-space:nowrap;">{{ .Name }}</td>
                  <td valign="top" style="padding:1px 0;word-break:break-word;">{{ .Value }}</td>
                </tr>
                {{ end }}
              </table>
            </td>
          </tr>
          {{ end }}
          {{ $hasExtra := false }}
          {{ range .Annotations.SortedPairs }}
          {{ if and (ne .Name "summary") (ne .Name "summary_fa") (ne .Name "description") (ne .Name "runbook") }}
          {{ $hasExtra = true }}
          {{ end }}
          {{ end }}
          {{ if $hasExtra }}
          <tr>
            <td style="padding:8px 25px 0 25px;font-family:Inter,Helvetica,Arial,sans-serif;font-size:13px;line-height:1.5;color:#000000;"><strong>Annotations</strong></td>
          </tr>
          <tr>
            <td style="padding:4px 25px 12px 25px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;font-family:Inter,Helvetica,Arial,sans-serif;font-size:13px;line-height:22px;color:#000000;">
                {{ range .Annotations.SortedPairs }}
                {{ if and (ne .Name "summary") (ne .Name "summary_fa") (ne .Name "description") (ne .Name "runbook") }}
                <tr>
                  <td valign="top" style="padding:1px 16px 1px 0;font-weight:700;white-space:nowrap;">{{ .Name }}</td>
                  <td valign="top" style="padding:1px 0;white-space:pre-line;word-break:break-word;">{{ .Value }}</td>
                </tr>
                {{ end }}
                {{ end }}
              </table>
            </td>
          </tr>
          {{ end }}
{{ end }}

{{ define "sms.sql_exporter.text" -}}
[{{ .CommonLabels.priority }}][{{ .Status | toUpper }}] {{ .CommonLabels.alertname }} on {{ .CommonLabels.instance }}{{ with .CommonLabels.db }}/{{ . }}{{ end }}{{ range .Alerts }} — {{ .Annotations.summary }}{{ end }}
{{- end }}
